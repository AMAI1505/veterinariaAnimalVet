# Copia este archivo a .env y reemplaza todos los valores antes del despliegue.
DOMAIN=animalvet.example.com
DB_NAME=animalvet
DB_USER=animalvet_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
ANIMALVET_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
INITIAL_RECEPTION_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
INITIAL_VET_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
# Déjalo en false salvo al adoptar con respaldo un esquema MySQL existente.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
